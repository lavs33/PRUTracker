{
  "version": 2,
  "installCommand": "npm --prefix frontend ci && npm --prefix backend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}